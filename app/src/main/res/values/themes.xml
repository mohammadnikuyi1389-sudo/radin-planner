<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme: plain black background, Compose owns all real styling.
         Kept deliberately minimal since every screen is Compose. -->
    <style name="Theme.ParsCode" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pc_bg</item>
        <item name="android:statusBarColor">@color/pc_bg</item>
        <item name="android:navigationBarColor">@color/pc_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
